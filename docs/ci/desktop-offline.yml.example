name: Desktop offline checks
on:
  pull_request:
  push:
    branches: ["codex/ember-desktop-dev-tools"]
permissions:
  contents: read
jobs:
  offline:
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 20
    defaults:
      run:
        working-directory: Baymax-main
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install desktop dependencies (no credentials or capture)
        run: python -m pip install -r requirements-pc.txt
      - name: Run core and toolkit offline gate
        run: python check_release.py --report .local-review/report.md
      - name: Verify native Mac frameworks import
        if: runner.os == 'macOS'
        run: python -c "import AVFoundation, cv2, sounddevice; assert callable(AVFoundation.AVCaptureDevice.devicesWithMediaType_)"
