#!/bin/bash
set -u
PYTHON=/opt/ember-python/python/bin/python3.12
CONFIG=/opt/ember-provision/ember-device-config.py
while CHOICE=$(whiptail --title 'Ember Device Settings' --menu 'Choose what to change. Settings survive Ember Git updates.' 22 78 12 \
  key 'Gemini key, microphone, speaker and camera' \
  wifi 'Hotspot / Wi-Fi connections (administrator password required)' \
  git 'Git repository, branch and automatic updates' \
  update 'Check Git and install an update now' \
  start 'Start / restart Ember' \
  stop 'Stop Ember' \
  boot 'Enable / disable Ember conversation on boot' \
  remote 'Open AnyDesk settings' \
  status 'View setup status and AnyDesk ID' \
  logs 'View recent installation and conversation logs' 3>&1 1>&2 2>&3); do
  case "$CHOICE" in
    key) xdg-open http://127.0.0.1:8766/ ;;
    wifi)
      clear
      echo 'Changing Wi-Fi can disconnect AnyDesk. Keep a known working hotspot available.'
      sudo /boot/dietpi/dietpi-network
      ;;
    git)
      SETTINGS=$("$PYTHON" "$CONFIG" read) || { read -r -p 'Press Enter to return.'; continue; }
      mapfile -t VALUES <<<"$SETTINGS"
      REPO=$(whiptail --title 'Ember Git repository' --inputbox 'HTTPS URL of an Ember-compatible repository. Keep credentials out of the URL.' 11 80 "${VALUES[0]}" 3>&1 1>&2 2>&3) || continue
      BRANCH=$(whiptail --title 'Ember Git branch' --inputbox 'Branch to deploy. Use a reviewed branch compatible with this board.' 10 80 "${VALUES[1]}" 3>&1 1>&2 2>&3) || continue
      AUTO=false
      if whiptail --title 'Automatic Git updates' --yesno 'Check Git and install validated updates on every boot? Choose No for manual updates only.' 10 76; then AUTO=true; fi
      if RESULT=$("$PYTHON" "$CONFIG" save --repository "$REPO" --branch "$BRANCH" --auto-update "$AUTO" 2>&1); then
        whiptail --msgbox 'Saved. Use Check Git and install an update now, or restart the board. The Gemini key is retained.' 10 76
      else
        whiptail --msgbox "$RESULT" 12 80
      fi
      ;;
    update)
      "$PYTHON" "$CONFIG" read >/dev/null || { read -r -p 'Press Enter to return.'; continue; }
      systemd-run --user --unit=ember-manual-update --collect /usr/local/bin/ember-update --now
      whiptail --msgbox 'Update requested in the background. Use Status or Logs to follow it. A failed update keeps the previous release.' 11 78
      ;;
    start) systemctl --user restart ember.service ;;
    stop) systemctl --user stop ember.service ;;
    boot)
      if whiptail --title 'Ember startup' --yesno 'Start the Ember conversation automatically on boot once a Gemini key is saved?' 11 78; then
        mkdir -p "$HOME/.config/ember"
        rm -f "$HOME/.config/ember/no-autostart"
        systemctl --user enable ember.service
      else
        mkdir -p "$HOME/.config/ember"
        touch "$HOME/.config/ember/no-autostart"
        systemctl --user disable --now ember.service
      fi
      ;;
    remote) anydesk --settings ;;
    status) xdg-open http://127.0.0.1:8765/ ;;
    logs)
      clear
      printf 'SYSTEM SETUP\n'
      sudo tail -n 35 /var/lib/ember/provision.log 2>/dev/null || true
      printf '\nEMBER UPDATE\n'
      tail -n 35 "$HOME/ember-deployment/logs/update.log" 2>/dev/null || true
      printf '\nCONVERSATION\n'
      journalctl --user -u ember.service -n 25 --no-pager
      read -r -p 'Press Enter to return.'
      ;;
  esac
done
