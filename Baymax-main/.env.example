OPENAI_API_KEY=your_openai_api_key_here

# Desktop Gemini development (configure through devUI)
GOOGLE_API_KEY=
BAYMAX_MIC_DEVICE=
BAYMAX_SPEAKER_DEVICE=
BAYMAX_CAMERA_DEVICE=
# Email credentials intentionally omitted for development.

# Location/weather Gemini tools (0 disables lookups and preloading)
BAYMAX_TOOLKIT_ENABLED=1

# Google Search grounding run by Gemini (only the search query goes to Google; 0 disables)
BAYMAX_GOOGLE_SEARCH=1

# Experimental fall detection (CPU, or NPU on a set-up Orange Pi); enable in Setup and restart Ember.
BAYMAX_FALL_DETECTION_ENABLED=0
# BAYMAX_FALL_FPS=15

# MVP eyes default on for Linux, off on other platforms. No servo.
# BAYMAX_EYES_ENABLED=0
# BAYMAX_EYES_PORT=/dev/serial/by-id/usb-Unknown_LattePanda_Leonardo-if00

# MVP local "hmm" after waits over 2s; requires working echo cancellation.
# BAYMAX_WAIT_CUE_ENABLED=0

# Lower speech-start sensitivity reduces false interruptions (default: low).
# BAYMAX_SPEECH_START_SENSITIVITY=low

# MVP keeps listening during replies but disables speech-triggered interruptions.
# Set 1 to restore interruptions; echo cancellation remains enabled independently.
# BAYMAX_INTERRUPTION_ENABLED=0

# Send silence to Gemini while Ember's speaker (plus a 250ms echo tail) is audible,
# so leaked robot speech never becomes a user turn. Defaults on when interruptions are off.
# BAYMAX_MUTE_MIC_DURING_REPLY=1

# High-pass cutoff (Hz) applied before echo cancellation/noise suppression/gain, to remove
# LattePanda fan rumble (measured 29/88/193 Hz). Default 200; 0 disables.
# BAYMAX_FAN_FILTER_HZ=200

# Additional correlated residual-echo subtraction (default on with audio enhancement).
# BAYMAX_RESIDUAL_ECHO_ENABLED=0

# X eyes ("unplug and replug") after Gemini is unreachable this many seconds (0 disables).
# BAYMAX_EYES_DEAD_AFTER_S=120
# Dimmed sleep eyes after this many seconds without conversation (0 disables).
# BAYMAX_EYES_SLEEP_AFTER_S=180
# X eyes when mic/speaker (5s) or camera (10s) stop reporting while connected. 0 disables.
# BAYMAX_EYES_SENSOR_WATCHDOG=1

# Eye-expression tool runs non-blocking with a SILENT result so Gemini does not speak
# its reply twice. Set 0 to restore the blocking tool (e.g. if a model rejects it).
# BAYMAX_EYE_TOOL_SILENT=1

# Post-session voice biomarker analysis at shutdown. MVP defaults to 0 so restarts
# take seconds; set 1 to analyse each session (slow on long sessions).
# BAYMAX_VOICE_ANALYSIS=0

# Opt-in robot updates before each start (see devops/mvp/README.md): follow a branch,
# run offline checks before switching, roll back if Ember never reaches listening.
# BAYMAX_AUTO_UPDATE=1
# BAYMAX_UPDATE_BRANCH=release

# Gemini prebuilt voice (default Autonoe; e.g. Fenrir, Sulafat, Puck, Kore). Unknown names are ignored.
# BAYMAX_VOICE=Autonoe

# Audiobook loudness relative to the recording (0-1, default 1 = full).
# BAYMAX_BOOK_VOLUME=1

# Ember speaks first: a hello at startup and a greeting on new eye contact (0 disables each).
# BAYMAX_STARTUP_GREETING=1
# BAYMAX_PRESENCE_GREETING=0  (eye-contact greetings; off by default, heavy on the robot CPU)
# BAYMAX_PRESENCE_QUIET_S=120
# BAYMAX_PRESENCE_COOLDOWN_S=600
# BAYMAX_PRESENCE_FPS=4

# LED eye expressions are picked locally from the conversation; 1 gives Gemini the
# set_eye_expression tool instead (it sometimes made Gemini repeat a whole reply).
# BAYMAX_EYE_TOOL=0

# Discovery tools: trivia, TV shows, poems, radio stations, recipes, Wikipedia, books.
# On by default (only the requested topic is sent to each free public service).
# EMBER_DISCOVERY_ENABLED=1

# Long conversations: trim old context and resume after Gemini's ~10 min connection resets.
# BAYMAX_CONTEXT_COMPRESSION=1
# BAYMAX_CONTEXT_TRIGGER_TOKENS=32000
# BAYMAX_SESSION_RESUMPTION=1
