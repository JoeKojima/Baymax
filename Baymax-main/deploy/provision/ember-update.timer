# Robot-local time: starts at a random moment between 2 and 3 AM, so the
# restart (if there is an update) happens inside the 2-4 AM window.
[Unit]
Description=Ember nightly update window

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=1h
AccuracySec=1min
Persistent=false

[Install]
WantedBy=timers.target
